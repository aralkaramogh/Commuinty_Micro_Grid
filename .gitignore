# Raw downloaded datasets: large (EMARC load file is 368 MB, above GitHub's 100 MB limit)
# and re-downloadable with mg_hier/tools/data/fetch_*.m. Only processed extracts are committed.
mg_hier/data/raw/

# Files created by Windows / Google Drive sync, not project content
desktop.ini
.tmp.driveupload/

# Scratch output of quick checks (not results)
mg_hier/results/tmp/

# Archived first model keeps its own separate git history
archive/mg_twin/

# ETAP: automatic backup, study results (regenerated on each run), service log
etap/**/BACKUP/
etap/**/*.LF1S
etap/**/*.SI1S
etap/**/*.HA1S
etap/**/*.SA3S
etap/**/*.RA1S
etap/**/Svclog.log
etap/**/_to_delete/
